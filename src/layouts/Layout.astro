---
export interface Props {
  title: string;
  description: string;
  path: string; // z.B. "/", "/verkaufen", ...
  image?: string; // Vorschaubild für Social Media (Pfad unter /public oder absolute URL)
  imageAlt?: string;
}
const {
  title,
  description,
  path,
  image = "/images/hero.jpg",
  imageAlt = "Marc Bertsch Immobilien – Immobilienmakler in Mannheim",
} = Astro.props;

const siteUrl = "https://bertsch-immo.de";
const siteName = "Marc Bertsch Immobilien";
const canonicalUrl = `${siteUrl}${path === "/" ? "" : path}`;
const imageUrl = image.startsWith("http") ? image : `${siteUrl}${image}`;

// Social-Profile (für Footer und Schema.org "sameAs")
const linkedinUrl = "https://www.linkedin.com/in/marc-bertsch-b759b4429/";
// TODO: Link zum Google-Unternehmensprofil eintragen (z. B. https://maps.app.goo.gl/...),
// sobald er vorliegt. Dann erscheint er automatisch im Footer und in "sameAs".
const googleProfileUrl = "https://maps.google.com/?cid=2060678126836525466";
const sameAs = [linkedinUrl, googleProfileUrl].filter(Boolean);

const navItems = [
  { href: "/", label: "Start" },
  { href: "/immobilien", label: "Immobilien" },
  { href: "/verkaufen", label: "Verkaufen" },
  { href: "/kaufen", label: "Kaufen" },
  { href: "/ueber-mich", label: "Über mich" },
  { href: "/kontakt", label: "Kontakt" },
];
---

<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Favicon -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#664f4f" />

<!-- Google Search Console: Verifizierungscode eintragen, sobald vorhanden
<meta name="google-site-verification" content="HIER-CODE-EINTRAGEN" />
-->

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Fonts lokal über @fontsource wäre ideal; für den Start CDN mit preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,340;0,9..144,420;0,9..144,560;1,9..144,380&family=Archivo:wght@400;500;600&display=swap" rel="stylesheet" />

<!-- Schema.org: RealEstateAgent (lokales SEO + GEO) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  "name": "Marc Bertsch Immobilien",
  "image": "https://bertsch-immo.de/images/hero.jpg",
  "url": "https://bertsch-immo.de",
  "telephone": "+49-176-41771712",
  "email": "marc.bertsch@bertsch-immo.de",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Weylstraße 8",
    "postalCode": "68167",
    "addressLocality": "Mannheim",
    "addressCountry": "DE"
  },
  "areaServed": ["Mannheim", "Ludwigshafen am Rhein", "Frankenthal", "Germersheim", "Eisenberg (Pfalz)"],
  "priceRange": "€€",
  "knowsAbout": "Immobilienverkauf, Immobilienbewertung, Immobilienkauf in Mannheim und der Metropolregion Rhein-Neckar",
  "sameAs": sameAs
})} />

<link rel="stylesheet" href="/styles/global.css" />
</head>
<body>

<header>
  <div class="container nav" id="nav">
    <a class="brand" href="/" aria-label="Marc Bertsch Immobilien – Startseite">
      <img src="/images/logo-negativ.svg" alt="Marc Bertsch Immobilien – Logo" />
    </a>
    <ul>
      {navItems.map(item => (
        <li><a href={item.href} class={path === item.href ? "active" : ""}>{item.label}</a></li>
      ))}
      <li><a href="https://www.noe-hoffmann.de/" target="_blank" rel="noopener" class="nav-partner-link">Noe &amp; Hoffmann ↗</a></li>
      <li><a class="btn btn-solid" href="/bewertung">Immobilienbewertung</a></li>
    </ul>
    <button class="nav-toggle" aria-label="Menü öffnen" id="navToggle">Menü</button>
  </div>
</header>

<main>
  <slot />
</main>

<footer>
  <div class="container foot-grid">
    <div>
      <img src="/images/logo-negativ.svg" alt="Marc Bertsch Immobilien" />
      <p>Marc Bertsch Immobilien · Weylstraße 8 · 68167 Mannheim<br />
      <a href="mailto:marc.bertsch@bertsch-immo.de">marc.bertsch@bertsch-immo.de</a> · <a href="tel:+4917641771712">0176 41771712</a></p>
      <ul class="foot-social" aria-label="Social Media">
        <li>
          <a href={linkedinUrl} target="_blank" rel="noopener" aria-label="Marc Bertsch auf LinkedIn (öffnet in neuem Tab)">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
        </li>
        {googleProfileUrl && (
          <li>
            <a href={googleProfileUrl} target="_blank" rel="noopener" aria-label="Marc Bertsch Immobilien bei Google (öffnet in neuem Tab)">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.24 10.29v3.6h5.06c-.22 1.3-1.55 3.8-5.06 3.8-3.05 0-5.53-2.52-5.53-5.63s2.48-5.63 5.53-5.63c1.73 0 2.9.74 3.56 1.37l2.43-2.34C16.67 3.99 14.65 3 12.24 3 7.27 3 3.24 7.03 3.24 12s4.03 9 9 9c5.2 0 8.64-3.65 8.64-8.8 0-.59-.06-1.04-.14-1.49l-8.5-.42z"/></svg>
            </a>
          </li>
        )}
      </ul>
    </div>
    <nav aria-label="Footer-Navigation">
      <a href="/bewertung">Immobilienbewertung</a>
      <a href="/immobilien">Immobilien</a>
      <a href="/verkaufen">Verkaufen</a>
      <a href="/kaufen">Kaufen</a>
      <a href="/ueber-mich">Über mich</a>
      <a href="/kontakt">Kontakt</a>
      <a href="https://www.noe-hoffmann.de/" target="_blank" rel="noopener">Noe &amp; Hoffmann ↗</a>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
    </nav>
  </div>
  <div class="container foot-bottom">
    <span>© 2026 Marc Bertsch Immobilien, Mannheim</span>
  </div>
</footer>

<script>
  // Mobiles Menü
  document.getElementById('navToggle')?.addEventListener('click', () => {
    document.getElementById('nav')?.classList.toggle('open');
  });

  // Scroll-Reveal (läuft auf jeder Seite neu)
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // Count-Up-Animation für Stats-Band
  function animateCount(el: HTMLElement) {
    const target = parseInt(el.dataset.count || "0", 10);
    const suffix = el.dataset.suffix || '';
    const duration = 1400;
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(eased * target) + suffix;
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  const statIo = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) {
      e.target.querySelectorAll('.stat-num').forEach(el => animateCount(el as HTMLElement));
      statIo.unobserve(e.target);
    }
  }), { threshold: 0.4 });
  document.querySelectorAll('.stats-band').forEach(el => statIo.observe(el));

  // Optionsbuttons (Formulare: Immobilienart auswählen)
  document.querySelectorAll('.opt-grid').forEach(g => {
    g.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      if (!target.classList.contains('opt')) return;
      g.querySelectorAll('.opt').forEach(o => o.classList.remove('selected'));
      target.classList.add('selected');
    });
  });
</script>

</body>
</html>
